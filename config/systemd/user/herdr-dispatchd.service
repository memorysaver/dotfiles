[Unit]
Description=Herdr Dispatch Broker for OpenAB Orchestrator
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/herdr-dispatchd --socket %h/.config/herdr-dispatchd/dispatch.sock --herdr-socket %h/.config/herdr/herdr.sock --state-dir %h/.config/herdr-dispatchd --allowed-root %h/Work
WorkingDirectory=%h/Work
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX
Restart=on-failure
RestartSec=2
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
